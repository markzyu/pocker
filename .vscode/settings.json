{
  "editor.inlayHints.enabled": "off",
  "rust-client.engine": "rust-analyzer",
  "rust-analyzer.checkOnSave": false,
  "cursor.cpp.disabledLanguages": [
    "markdown",
    "plaintext",
    "rust"
  ],
  "rust-analyzer.check.overrideCommand": [
    "cargo",
    "check",
    "--target=x86_64-unknown-linux-gnu",
    "--message-format=json"
  ]
}